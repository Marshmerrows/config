# Font
font-family = VictorMono Nerd Font Mono
font-size = 12
font-thicken = true

# Theme — matches nvim (kanagawa-dragon)
theme = Kanagawa Dragon

# Window
window-padding-x = 8
window-padding-y = 8
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = false

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration = zsh
shell-integration-features = no-cursor,sudo,ssh-env

# Scrollback (iTerm2 had unlimited; 100k is sane)
scrollback-limit = 100000

# Quality of life
mouse-hide-while-typing = true
copy-on-select = true
confirm-close-surface = false
quit-after-last-window-closed = false
clipboard-paste-protection = false

# Splits
split-divider-color = gray
unfocused-split-fill = white

# Quick-terminal toggle. Hammerspoon binds option+space, activates Ghostty
# (so the menu bar swaps and on close focus falls back to another Ghostty
# window), then forwards this hyper-key combo here.
keybind = global:cmd+shift+ctrl+alt+f18=toggle_quick_terminal
quick-terminal-position = bottom
quick-terminal-autohide = false
